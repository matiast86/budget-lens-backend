// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  email          String          @unique
  birthDate      DateTime
  password       String          @db.VarChar(64)
  gender         Gender
  role           Role            @default(USER)
  ledgers        Ledger[]        @relation("UserLedgers")
  collaborations Collaboration[] @relation("UserCollaborations")
  paymentMethods  PaymentMethod[] @relation("UserPaymentMethods")
  groups         Group[]         @relation("UserGroups")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@map("users")
}

model Ledger {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?
  ownerId        String           @db.Uuid
  debtOwners     DebtOwner[]      @relation("LedgerDebtOwners")
  owner          User             @relation("UserLedgers", fields: [ownerId], references: [id])
  collaborations Collaboration[]  @relation("LedgerCollaborations")
  groups         Group[]          @relation("LedgerGroups")
  categories     Category[]         @relation("LedgerCategories")
  transactions   Transaction[]    @relation("LedgerTransactions")
  paymentMethods LedgerPaymentMethod[] @relation("LedgerPaymentMethods")
  isActive       Boolean         @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("ledgers")
}

model Collaboration {
  id        Int               @id @default(autoincrement())
  name      String
  isActive  Boolean            @default(true)
  userId    String             @db.Uuid
  ledgerId  Int
  user      User               @relation("UserCollaborations", fields: [userId], references: [id])
  ledger    Ledger             @relation("LedgerCollaborations", fields: [ledgerId], references: [id])

  @@unique([userId, ledgerId])

  @@map("collaborations")
}

model PaymentMethod {
  id        Int              @id @default(autoincrement())
  name      String
  type      PaymentType
  brand     CreditBrand?
  color String? 
  icon  String?
  currency Currency?
  isActive Boolean @default(true)
  userId    String           @db.Uuid
  user      User             @relation("UserPaymentMethods", fields: [userId], references: [id])
  transactions Transaction[] @relation("PaymentMethodTransactions")
  ledgers   LedgerPaymentMethod[]

  @@unique([userId, name])
  @@unique([id, userId])


  @@map("payment_methods")
}

model LedgerPaymentMethod {
  paymentMethod  PaymentMethod  @relation(fields: [paymentMethodId], references: [id])
  paymentMethodId Int
  ledger       Ledger      @relation("LedgerPaymentMethods", fields: [ledgerId], references: [id])
  ledgerId     Int
  assignedAt   DateTime    @default(now())
  assignedBy   String

  @@id([paymentMethodId, ledgerId])
  @@map("ledgers_payment_methods")
}

model Debt {
  id           Int         @id @default(autoincrement())
  debtOwner    DebtOwner   @relation("DebtOwner", fields: [debtOwnerId], references: [id])
  debtOwnerId  Int
  direction    DebtDirection
  amount       Float
  period       DateTime

  @@map("debts")
}

model DebtOwner {
  id     Int     @id @default(autoincrement())
  name   String
  ledgerId Int

  ledger Ledger @relation("LedgerDebtOwners", fields: [ledgerId], references: [id])
  debts  Debt[]  @relation("DebtOwner")
  transactions Transaction[] @relation("TransactionDebtOwner")

  @@unique([ledgerId, name])

  @@map("debt_owners")
}

model CategoryTemplate {
  id           Int            @id @default(autoincrement())
  name         String         @unique
  description  String? 
  scope      CategoryScope

  categories   Category[]     @relation("TemplateCategories")

  @@map("categories_template")
}


model Category {
  id            Int             @id @default(autoincrement())
  name          String          
  description   String?
  ledgerId      Int
  templateId    Int?

  ledger       Ledger           @relation("LedgerCategories", fields: [ledgerId], references: [id])
  template     CategoryTemplate? @relation("TemplateCategories", fields: [templateId], references: [id])
  transactions  Transaction[]   @relation("TransactionCategory")

  @@unique([ledgerId, name])

  @@map("categories")
}

model Group {
  id            Int             @id @default(autoincrement())
  name          String
  ledgerId      Int
  userId        String           @db.Uuid
  ledger        Ledger          @relation("LedgerGroups", fields: [ledgerId], references: [id])
  transactions  Transaction[]    @relation("TransactionGroup")
  user          User             @relation("UserGroups", fields: [userId], references: [id])


  @@unique([ledgerId, name])

  @@map("groups")
}

model Transaction {
  id                    Int                     @id @default(autoincrement())
  ledgerId              Int
  status                Status
  entryType             EntryType
  categoryId            Int
  groupId               Int?
  transactionDate       DateTime
  paymentMonth          DateTime
  installments          Int                     @default(1)
  installment           Int                     @default(1)
  comment               String?
  currency              Currency
  totalAmount           Decimal
  monthlyAmount         Decimal
  type                  TransactionType        @default(VARIABLE)
  debtOwnerId           Int?
  paymentMethodId       Int
  transactionsBreakDown TransactionBreakDown[]  @relation("TransactionsBreakDown")

  ledger      Ledger      @relation("LedgerTransactions", fields: [ledgerId], references: [id])
  category    Category    @relation("TransactionCategory", fields: [categoryId], references: [id])
  group       Group?      @relation("TransactionGroup", fields: [groupId], references: [id])
  paymentMethod PaymentMethod @relation("PaymentMethodTransactions", fields: [paymentMethodId], references: [id])
  debtOwner   DebtOwner? @relation("TransactionDebtOwner", fields: [debtOwnerId], references: [id])

  @@map("transactions")
}

model TransactionBreakDown {
  id             Int          @id @default(autoincrement())
  transactionId  Int
  weekNumber     Int
  amount         Decimal

  transaction    Transaction  @relation("TransactionsBreakDown", fields: [transactionId], references: [id])

  @@map("transactions_break_down")
}

// =====================================================
// ENUMS
// =====================================================

enum Gender {
  MALE
  FEMALE
}

enum Role {
  ADMIN
  USER
}


enum EntryType {
  INCOME
  EXPENSE
}

enum CreditBrand {
  VISA
  AMEX
  MASTER
  OTHER
}

enum PaymentType {
  CASH
  BANK
  WALLET
  CREDIT_CARD
  OTHER
}

enum DebtDirection {
  OWED_TO_ME   // They owe me
  OWED_BY_ME   // I owe them
}

enum Currency {
  ARS
  USD
}

enum Status {
  CLOSED
  CURRENT
  FUTURE
}

enum TransactionType {
  FIXED
  VARIABLE
}

enum CategoryScope {
  GLOBAL
}

