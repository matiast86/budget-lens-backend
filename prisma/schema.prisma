// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"

}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  email          String          @unique
  birthDate      DateTime
  password       String          @db.VarChar(64)
  gender         Gender
  role           Role            @default(USER)
  ledgers        Ledger[]        @relation("UserLedgers")
  collaborations Collaboration[] @relation("UserCollaborations")
  creditCards CreditCard[]       @relation("UserCreditCards")
  groups      Group[]            @relation("UserGroups")
  isActive      Boolean          @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}


model Ledger {
  id             Int             @id @default(autoincrement())
  name           String
  description    String
  ownerId        String          @db.Uuid
  owner          User            @relation("UserLedgers", fields: [ownerId], references: [id])
  collaborations Collaboration[] @relation("LedgerCollaborations")
  groups         Group[]         @relation("LedgerGroups")
  transactions Transaction[] @relation("LedgerTransactions")
  creditCards LedgerCreditCard[]  @relation("LedgerCreditCards")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Collaboration {
  id        Int              @id @default(autoincrement())
  role      CollaborationRole @default(COLLABORATOR)
  userId    String            @db.Uuid
  ledgerId  Int
  user      User              @relation("UserCollaborations", fields: [userId], references: [id])
  ledger    Ledger            @relation("LedgerCollaborations", fields: [ledgerId], references: [id])
}

model CreditCard {
  id        Int              @id @default(autoincrement())
  name String
  type CreditBrand
  userId String @db.Uuid
  user User @relation("UserCreditCards", fields: [userId], references: [id])
  ledgers LedgerCreditCard[] 

}

model LedgerCreditCard {
  creditCard CreditCard @relation(fields: [creditCardId], references: [id])
  creditCardId Int
  ledger Ledger @relation("LedgerCreditCards", fields: [ledgerId], references: [id])
  ledgerId Int
  assignedAt DateTime @default(now())
  assignedBy String

  @@id([creditCardId, ledgerId])
}

model Debt {
  id        Int              @id @default(autoincrement())
  owner DebtOwner @relation("DebtOwner", fields: [debtOwnerId], references: [id])
  debtOwnerId Int
  direction DebtDirection
  amount Float
  month DateTime


}

model DebtOwner {
  id        Int              @id @default(autoincrement())
  name String
  debts Debt[] @relation("DebtOwner")
}

model PaymentMethod {
  id        Int              @id @default(autoincrement())
  name String
  type PaymentType
}

model Category {
  id        Int              @id @default(autoincrement())
  name String   @unique
  description String?

  transactions Transaction[] @relation("TransactionCategory")
}

model Group {
  id        Int              @id @default(autoincrement())
  name String
  ledgerId Int ?
  userId String @db.Uuid
  isGlobal Boolean @default(false)

  ledger    Ledger?   @relation("LedgerGroups", fields: [ledgerId], references: [id])
  transactions Transaction[] @relation("TransactionGroup")
  user User @relation("UserGroups", fields: [userId], references: [id])

  
}

model Transaction {
  id        Int              @id @default(autoincrement())
  ledgerId Int
  status Status
  entryType EntryType
  categoryId Int
  groupId Int?
  transactionDate DateTime
  paymentMonth DateTime?
  installments Int @default(1)
  installment Int @default(1)
  comment  String?
  currency Currency
  totalAmount Decimal
  monthlyAmount Decimal
  debtOwnerId Int?
  transactionsBreakDown TransactionBreakDown[] @relation("TransactionsBreakDown")

  ledger Ledger @relation("LedgerTransactions", fields: [ledgerId], references: [id])
  category Category @relation("TransactionCategory", fields: [categoryId], references: [id])
  group Group? @relation("TransactionGroup", fields: [groupId], references: [id])


}

model TransactionBreakDown {
  id        Int              @id @default(autoincrement())
  transactionId Int
  weekNumber Int
  amount Decimal

  transaction Transaction @relation("TransactionsBreakDown", fields: [transactionId], references: [id])
}

enum Gender {
  MALE
  FEMALE
}

enum Role {
  ADMIN
  USER
}

enum CollaborationRole {
  COLLABORATOR
}

enum EntryType {
  INCOME
  EXPENSE
}

enum CreditBrand {
  VISA
  AMEX
  MASTER
  OTHER
}

enum PaymentType {
  CASH
  BANK
  WALLET
  CREDIT_CARD
  DEBT
  OTHER
}

enum DebtDirection {
  OWED_TO_ME   // They owe me
  OWED_BY_ME   // I owe them
}

enum Currency {
  ARS
  USD
}
enum Status {
  CLOSED
  CURRENT
  FUTURE
}

