// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  email          String          @unique
  birthDate      DateTime
  gender         Gender
  role           Role            @default(USER)
  ledgers        Ledger[]        @relation("UserLedgers")
  collaborations Collaboration[] @relation("UserCollaborations")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}


model Ledger {
  id             Int             @id @default(autoincrement())
  name           String
  description    String
  ownerId        String          @db.Uuid
  owner          User            @relation("UserLedgers", fields: [ownerId], references: [id])
  collaborations Collaboration[] @relation("LedgerCollaborations")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Collaboration {
  id        Int              @id @default(autoincrement())
  role      CollaborationRole @default(COLLABORATOR)
  userId    String            @db.Uuid
  ledgerId  Int
  user      User              @relation("UserCollaborations", fields: [userId], references: [id])
  ledger    Ledger            @relation("LedgerCollaborations", fields: [ledgerId], references: [id])
}

model CreditCard {
  id        Int              @id @default(autoincrement())
  name String
  type CreditBrand

}

model Debt {
  id        Int              @id @default(autoincrement())
  owner DebtOwner @relation("DebtOwner", fields: [debtOwnerId], references: [id])
  debtOwnerId Int
  directio DebtDirection
  amount Float
  month DateTime


}

model DebtOwner {
  id        Int              @id @default(autoincrement())
  name String
  debts Debt[] @relation("DebtOwner")
}

model PaymentMethod {
  id        Int              @id @default(autoincrement())
  name String
  type PaymentType
}



enum Gender {
  MALE
  FEMALE
}

enum Role {
  ADMIN
  USER
}

enum CollaborationRole {
  COLLABORATOR
}

enum EntryType {
  INCOME
  EXPENSE
}

enum CreditBrand {
  VISA
  AMEX
  MASTER
  OTHER
}

enum PaymentType {
  CASH
  BANK
  WALLET
  CREDIT_CARD
  DEBT
  OTHER
}

enum DebtDirection {
  OWED_TO_ME   // They owe me
  OWED_BY_ME   // I owe them
}

